# OAuth client IDs (wire real apps before enabling One Tap in the browser)
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=common

# API base URL for token exchange (FastAPI platform)
VITE_API_BASE_URL=http://localhost:8000

# Crawl.Api (.NET job crawler) — Start / Details / History screens
VITE_CRAWL_API_URL=http://localhost:5059

# Stripe publishable key (pk_test_...) — optional; billing page also loads it from API
VITE_STRIPE_PUBLISHABLE_KEY=
